<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>HOTICE Portal</title>

<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
body {
    font-family: Inter, sans-serif;
    background: #0f172a;
    color: white;
}

.hidden { display:none; }

.glass {
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.05);
}
</style>
</head>

<body>

<!-- HEADER -->
<header class="p-4 flex justify-between items-center border-b border-slate-800 glass">

    <h1 class="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-amber-500">
        HOTICE Immunotech
    </h1>

    <a href="login.html" class="text-sm text-slate-400 hover:text-white">
        Logout
    </a>

</header>

<!-- HERO -->
<section class="p-6 text-center">
    <h2 class="text-3xl font-extrabold">Command Portal Active</h2>
    <p class="text-slate-400">Disease Intelligence System</p>
</section>

<!-- TABS -->
<div class="flex gap-2 px-4">

    <button onclick="showTab('patient')" class="px-3 py-2 bg-teal-500 text-black rounded">
        Patient
    </button>

    <button onclick="showTab('medical')" class="px-3 py-2 bg-slate-800 rounded">
        Medical
    </button>

    <button onclick="showTab('student')" class="px-3 py-2 bg-slate-800 rounded">
        Internship
    </button>

</div>

<!-- PATIENT -->
<section id="patient" class="p-4">

    <div class="glass p-4 rounded-lg">
        <h3 class="font-bold mb-2">Report Symptom</h3>

        <input class="w-full p-2 bg-slate-900 rounded mb-2" placeholder="Symptoms">

        <input class="w-full p-2 bg-slate-900 rounded mb-2" placeholder="Location">

        <button class="w-full bg-teal-500 text-black font-bold py-2 rounded">
            Submit Report
        </button>
    </div>

</section>

<!-- MEDICAL -->
<section id="medical" class="p-4 hidden">

    <div class="glass p-4 rounded-lg">
        <h3 class="font-bold">Medical Dashboard</h3>
        <p class="text-slate-400">Tracking incidents...</p>
    </div>

</section>

<!-- STUDENT -->
<section id="student" class="p-4 hidden">

    <div class="glass p-4 rounded-lg">

        <h3 class="font-bold mb-2">Internships</h3>

        <input id="search"
               onkeyup="filterJobs()"
               class="w-full p-2 bg-slate-900 rounded mb-2"
               placeholder="Search jobs">

        <div class="job p-2 bg-slate-900 rounded mb-2">Lab Internship</div>
        <div class="job p-2 bg-slate-900 rounded mb-2">Field Epidemiology</div>
        <div class="job p-2 bg-slate-900 rounded mb-2">Public Health Assistant</div>

    </div>

</section>

<!-- JS -->
<script>

function showTab(tab) {
    document.querySelectorAll('section').forEach(s => {
        if(['patient','medical','student'].includes(s.id)){
            s.classList.add('hidden');
        }
    });

    document.getElementById(tab).classList.remove('hidden');
}

function filterJobs() {
    let val = document.getElementById("search").value.toLowerCase();

    document.querySelectorAll(".job").forEach(job => {
        job.style.display = job.textContent.toLowerCase().includes(val)
        ? "block"
        : "none";
    });
}

</script>
<script type="module">
import { addDoc, collection } from "https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore.js";

window.submitReport = async function () {

    const data = {
        symptom: "fever",
        location: "unknown",
        time: new Date()
    };

    await addDoc(collection(window.db, "reports"), data);

    alert("Report saved to system");
}
</script>

</body>
</html>